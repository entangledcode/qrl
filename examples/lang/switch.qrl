-- The quantum switch: the canonical causally nonseparable process.
--
-- Both operations are unitary (X and Z), so switch(...) type-checks as
-- Switch(2): the switch construct, with the control (here |+>) as its input.
-- qrl exec certifies the construct with a measurable causal witness (Araujo
-- et al. 2015): a past party P prepares the control (six states), A and B
-- apply ten unitaries, F measures the control.  Every causally separable
-- process scores >= 0; the switch construct scores -0.1694.
--
--   qrl check examples/lang/switch.qrl   ->   ok  : Switch(2)
--   qrl exec  examples/lang/switch.qrl   ->   Process(1x2x2x2, witness=-0.1694 (certified nonseparable))

let X : UniProc(2) = cptp([[0, 1], [1, 0]]) in
let Z : UniProc(2) = cptp([[1, 0], [0, -1]]) in
switch(X, Z, |+>)
